# ----------------------------------------------------------------------------|
# ERC-3643 Environment Variables (Example)
# ----------------------------------------------------------------------------|
# Copy this file to `.env` and fill in the values that apply to your setup.
# All private keys should be provided without the leading `0x` unless stated
# otherwise. Keep your real `.env` out of source control.
# ----------------------------------------------------------------------------|

# Core network configuration ---------------------------------------------------
REDBELLY_STAGING_RPC=https://rbn9bb267fa.staging.redbelly.network/rpc
REDBELLY_TESTNET_RPC=https://governors.testnet.redbelly.network
REDBELLY_MAINNET_RPC=https://governors.mainnet.redbelly.network

TARGET_NETWORK=redbellyStaging

# ----------------------------------------------------------------------------|
# Role-based private keys
# Provide the private key (hex string without 0x) for each account that will
# operate in your deployment. Leave unused roles blank.
# ----------------------------------------------------------------------------|

# 1. Infrastructure Deployer - deploys core implementations & factory
INFRA_DEPLOYER_PRIVATE_KEY=

# 2. Token Issuer / Owner - owns each security token contract
TOKEN_ISSUER_PRIVATE_KEY=

# 3. Claim Issuer Manager - owns the ClaimIssuer contract (manages signers)
CLAIM_ISSUER_OWNER_PRIVATE_KEY=

# 4. Claim Signing Key(s) - used by backend to sign KYC claims
#    Set at least one. Supports multiple keys via numbered variants.
#    The script will load all available keys (up to 5).
CLAIM_ISSUER_SIGNER_PRIVATE_KEY=      # Optional: base name
CLAIM_ISSUER_SIGNER_PRIVATE_KEY_1=   # Recommended: first signing key
CLAIM_ISSUER_SIGNER_PRIVATE_KEY_2=   # Optional: second signing key (for redundancy)
CLAIM_ISSUER_SIGNER_PRIVATE_KEY_3=   # Optional: third signing key
CLAIM_ISSUER_SIGNER_PRIVATE_KEY_4=   # Optional: fourth signing key

# 5. Investor Registration Agent - registers identities in identity registry
REGISTRATION_AGENT_PRIVATE_KEY=

# 6. Token Operations Agent - mints/burns tokens, forced transfers, etc.
TOKEN_OPERATIONS_AGENT_PRIVATE_KEY=

# 7. Compliance Manager - updates compliance modules & trusted issuers
COMPLIANCE_MANAGER_PRIVATE_KEY=

# Optional: Treasury / Custody account(s)
TREASURY_AGENT_PRIVATE_KEY=

# Optional: Initial investor wallets for testing / demos
INVESTOR_PRIVATE_KEY_1=
INVESTOR_PRIVATE_KEY_2=

# ----------------------------------------------------------------------------|
# Token deployment configuration (required for deployToken.ts)
# ----------------------------------------------------------------------------|
TOKEN_NAME=
TOKEN_SYMBOL=
TOKEN_DECIMALS=0

# ----------------------------------------------------------------------------|
# Script-specific overrides (optional)
# ----------------------------------------------------------------------------|

# Used by scripts/registerInvestor.ts
REGISTRATION_TARGET_TOKEN=    # e.g. 0xTokenAddress
REGISTRATION_INVESTOR_ADDRESS=
REGISTRATION_INVESTOR_COUNTRY=840

# Used by scripts/addClaimToInvestor.ts when no CLI args are supplied
ADD_CLAIM_INVESTOR_ADDRESS=
ADD_CLAIM_IDENTITY_ADDRESS=
ADD_CLAIM_TOPIC=0x0fcfa10035044c80f593fee52cb5bdc69fc4ee08fd995d1366281d153155f807

# Used by scripts/verifyInvestor.ts when no CLI args are supplied
VERIFY_TARGET_TOKEN=
VERIFY_INVESTOR_ADDRESS=